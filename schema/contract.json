{
  "_comment": "数据脑侧的确定性契约副本。enums / required_offer_fields / schema_major_supported / stale_threshold_hours 必须与技能端 references/valuation-constants.json 及 references/data-schema.md 保持一致；任一侧变更须同步本文件并重跑 --selftest。",
  "contract_version": "1.0.0",
  "schema_version": "1.0",
  "schema_major_supported": "1",
  "stale_threshold_hours": "2",
  "max_verified_age_days": 7,
  "source_note": "本表仅收录经官方页面核验的公开免费额度信息；额度与政策随时可能调整，一律以各平台官方最新公告为准，不构成任何收益或使用承诺。",
  "enums": {
    "modality": ["image", "video"],
    "quota_unit": ["count", "second", "credit"],
    "quota_period": ["once", "daily", "per_style_daily", "monthly", "unknown"],
    "watermark": ["none", "visible", "conditional"],
    "commercial_rights": ["allowed", "restricted", "unknown"],
    "queue_speed": ["instant", "fast", "normal", "slow"],
    "resolution": ["1k", "2k", "4k", "720p", "1080p", "variable"],
    "offer_status": ["verified", "pending_official", "expired", "discontinued"],
    "money_basis": ["face_value", "unit_price", "official_price", "none"]
  },
  "default_offer_status": "verified",
  "default_money_basis": "official_price",
  "optional_offer_fields": ["status", "deadline", "money_basis", "note"],
  "required_offer_fields": [
    "provider",
    "modality",
    "quota",
    "watermark",
    "commercial_rights",
    "queue_speed",
    "resolution"
  ],
  "rejection_rules": [
    {
      "id": "rebate_invite",
      "label": "返利/邀请",
      "keywords": ["返利", "返现", "邀请码", "邀请好友", "拉新奖励", "分销", "推广佣金"],
      "reason": "收益依赖拉人或消费返现，不是可直接使用的免费额度"
    },
    {
      "id": "relay_proxy",
      "label": "中转站/逆向",
      "keywords": ["中转站", "API 中转", "api中转", "中转 API", "逆向接口", "破解版", "代理转发"],
      "reason": "转售或绕过官方计费，来源与稳定性不可核验，且违反平台条款"
    },
    {
      "id": "secondhand_credit",
      "label": "二手/共享额度",
      "keywords": ["二手积分", "转让积分", "共享账号", "合租账号", "代充"],
      "reason": "额度归属不清晰，存在账号被回收与条款违规风险"
