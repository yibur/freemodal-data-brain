    {
      "id": "sms_multi_account",
      "label": "接码/多开",
      "keywords": ["接码", "多开", "虚拟号", "批量注册", "换号注册"],
      "reason": "以规避风控方式获取额度，违反平台服务条款"
    },
    {
      "id": "requires_topup",
      "label": "需先充值",
      "keywords": ["需先充值", "必须先充值", "充值后赠送", "首充", "充值满", "预存"],
